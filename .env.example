# Copy to .env and fill with your Firebase web app config
# (Firebase console > Project settings > Your apps > Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Public origin printed into QR codes and loyalty card links (your live domain, https only).
# Counter QR codes encode <origin>/card/<business-slug>, so set this to your production domain.
VITE_PUBLIC_APP_ORIGIN=https://loyaltydigitalqr.com

# Optional: point image uploads at an external Cloudflare Worker instead of the
# built-in /api/upload endpoint. Leave empty to use /api/upload (recommended).
VITE_UPLOAD_API_URL=

# Support email shown to merchants for billing questions (optional)
VITE_SUPPORT_EMAIL=

# -----------------------------------------------------------------------------
# Server-side image upload (Cloudflare R2). Used by /api/upload (api/upload.ts
# on Vercel, and the vite dev middleware locally). These are SECRET — they must
# NOT have a VITE_ prefix, so they never reach the browser. On Vercel, add them
# under Project Settings > Environment Variables.
# -----------------------------------------------------------------------------
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_PUBLIC_BASE_URL=
