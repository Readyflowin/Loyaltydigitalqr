# Copy to .env and fill with your Firebase web app config
# (Firebase console > Project settings > Your apps > Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Public origin printed into QR codes (your live domain, https only)
VITE_PUBLIC_APP_ORIGIN=https://your-project.web.app

# Cloudflare Worker URL for image uploads (after: cd worker && npx wrangler deploy)
VITE_UPLOAD_API_URL=
